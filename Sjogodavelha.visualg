algoritmo "SuperJogoDaVelha"
// Super Jogo da Velha - regras do trabalho:
// 1) Os jogadores alternam as jogadas, mas precisam TERMINAR o mini-jogo
//    em andamento antes de ir para outro.
// 2) Se alguem vencer o mini-jogo, ele fica marcado com o vencedor.
// 3) Se o mini-jogo der velha, o espaco no tabuleiro grande fica VAZIO
//    (o mini-jogo e limpo) e o proximo jogador escolhe qual mini-jogo
//    jogar, podendo ser o mesmo.
// 4) Vence quem marcar 3 mini-jogos em linha no tabuleiro grande.

var
   tab: vetor[1..9,1..9] de caractere
   vencedor: vetor[1..9] de caractere
   aux: vetor[1..9] de caractere
   comb: vetor[1..8,1..3] de inteiro
   jogador, res, resAux: caractere
   jogo, casa, i, gm, atual: inteiro
   valido, acabou, cheio, todos: logico

procedimento iniciar
var a, b: inteiro
inicio
   para a de 1 ate 9 faca
      vencedor[a] <- " "
      para b de 1 ate 9 faca
         tab[a,b] <- " "
      fimpara
   fimpara
   comb[1,1] <- 1
   comb[1,2] <- 2
   comb[1,3] <- 3
   comb[2,1] <- 4
   comb[2,2] <- 5
   comb[2,3] <- 6
   comb[3,1] <- 7
   comb[3,2] <- 8
   comb[3,3] <- 9
   comb[4,1] <- 1
   comb[4,2] <- 4
   comb[4,3] <- 7
   comb[5,1] <- 2
   comb[5,2] <- 5
   comb[5,3] <- 8
   comb[6,1] <- 3
   comb[6,2] <- 6
   comb[6,3] <- 9
   comb[7,1] <- 1
   comb[7,2] <- 5
   comb[7,3] <- 9
   comb[8,1] <- 3
   comb[8,2] <- 5
   comb[8,3] <- 7
fimprocedimento

// Confere o vetor aux. Resultado em resAux: "X", "O" ou " "
procedimento checarAux
var l, a, b, c: inteiro
inicio
   resAux <- " "
   para l de 1 ate 8 faca
      a <- comb[l,1]
      b <- comb[l,2]
      c <- comb[l,3]
      se resAux = " " entao
         se (aux[a] <> " ") e (aux[a] = aux[b]) e (aux[a] = aux[c]) entao
            resAux <- aux[a]
         fimse
      fimse
   fimpara
fimprocedimento

// Verifica se o mini-jogo gm esta cheio. Resultado em cheio
procedimento checarMiniCheio
var k: inteiro
inicio
   cheio <- verdadeiro
   para k de 1 ate 9 faca
      se tab[gm,k] = " " entao
         cheio <- falso
      fimse
   fimpara
fimprocedimento

// Limpa o mini-jogo gm (usado quando da velha)
procedimento limparMini
var k: inteiro
inicio
   para k de 1 ate 9 faca
      tab[gm,k] <- " "
   fimpara
fimprocedimento

// Verifica se todos os mini-jogos ja foram vencidos. Resultado em todos
procedimento checarTodos
var k: inteiro
inicio
   todos <- verdadeiro
   para k de 1 ate 9 faca
      se vencedor[k] = " " entao
         todos <- falso
      fimse
   fimpara
fimprocedimento

procedimento mostrar
var gi, gj, a, b, g, ca, r: inteiro
inicio
   escreval("")
   escreval("=== MINI-JOGOS ===")
   para gi de 1 ate 3 faca
      para a de 1 ate 3 faca
         para gj de 1 ate 3 faca
            g <- (gi-1)*3 + gj
            para b de 1 ate 3 faca
               ca <- (a-1)*3 + b
               escreva(tab[g,ca])
               se b < 3 entao
                  escreva("|")
               fimse
            fimpara
            se gj < 3 entao
               escreva("  #  ")
            fimse
         fimpara
         escreval("")
      fimpara
      se gi < 3 entao
         escreval("#########################")
      fimse
   fimpara
   escreval("")
   escreval("=== TABULEIRO GRANDE (vazio = ainda sem vencedor) ===")
   para r de 0 ate 2 faca
      escreval(vencedor[r*3+1], "|", vencedor[r*3+2], "|", vencedor[r*3+3])
   fimpara
   escreval("")
fimprocedimento

inicio
   iniciar
   jogador <- "X"
   acabou <- falso
   res <- " "
   atual <- 0
   escreval("Mini-jogos e casas sao numerados de 1 a 9:")
   escreval("1 2 3")
   escreval("4 5 6")
   escreval("7 8 9")

   repita
      mostrar

      repita
         valido <- verdadeiro
         se atual = 0 entao
            escreva("Jogador ", jogador, " - escolha o mini-jogo (1-9): ")
            leia(jogo)
         senao
            jogo <- atual
            escreval("Jogador ", jogador, " - voce deve continuar o mini-jogo ", jogo)
         fimse
         escreva("Jogador ", jogador, " - casa (1-9): ")
         leia(casa)
         se (jogo < 1) ou (jogo > 9) ou (casa < 1) ou (casa > 9) entao
            valido <- falso
         senao
            se vencedor[jogo] <> " " entao
               valido <- falso
            senao
               se tab[jogo,casa] <> " " entao
                  valido <- falso
               fimse
            fimse
         fimse
         se nao valido entao
            escreval("Jogada invalida, tente de novo.")
         fimse
      ate valido

      tab[jogo,casa] <- jogador
      atual <- jogo

      // mini-jogo decidido?
      para i de 1 ate 9 faca
         aux[i] <- tab[jogo,i]
      fimpara
      checarAux
      se resAux <> " " entao
         vencedor[jogo] <- resAux
         atual <- 0
         escreval(">> Jogador ", resAux, " ganhou o mini-jogo ", jogo, "!")
      senao
         gm <- jogo
         checarMiniCheio
         se cheio entao
            limparMini
            atual <- 0
            escreval(">> Mini-jogo ", jogo, " deu velha e foi limpo. O proximo jogador escolhe o mini-jogo.")
         fimse
      fimse

      // jogo grande decidido?
      para i de 1 ate 9 faca
         aux[i] <- vencedor[i]
      fimpara
      checarAux
      res <- resAux
      se res <> " " entao
         acabou <- verdadeiro
      senao
         checarTodos
         se todos entao
            acabou <- verdadeiro
         fimse
      fimse

      se nao acabou entao
         se jogador = "X" entao
            jogador <- "O"
         senao
            jogador <- "X"
         fimse
      fimse
   ate acabou

   mostrar
   se res <> " " entao
      escreval("*** FIM: o jogador ", res, " VENCEU O SUPER JOGO DA VELHA! ***")
   senao
      escreval("*** FIM: empate! ***")
   fimse
fimalgoritmo
